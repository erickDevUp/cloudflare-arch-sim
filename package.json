{
  "name": "cloudflare-arch-sim",
  "version": "1.0.0",
  "description": "A drag-and-drop Cloudflare architecture simulator that renders **inside an Orca chat**.",
  "bin": {
    "cloudflare-arch-sim": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "serve.mjs",
    "scenario.json",
    "dist/cloudflare-arch-sim.html",
    "src/scenario.js",
    "src/catalog.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node cli.mjs",
    "build": "node build.mjs",
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test",
    "check:dist": "node check-dist.mjs",
    "pack:check": "npm pack --dry-run --json",
    "prepublishOnly": "node --test && node build.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "lucide-static": "^1.77.0"
  }
}
