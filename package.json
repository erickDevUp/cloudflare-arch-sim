{
  "name": "cloudflare-arch-sim",
  "version": "1.0.0",
  "description": "A drag-and-drop Cloudflare architecture simulator that renders **inside an Orca chat**.",
  "bin": {
    "cloudflare-arch-sim": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "serve.mjs",
    "scenario.json",
    "dist/cloudflare-arch-sim.html",
    "src/scenario.js",
    "src/catalog.js",
    "src/engine.js",
    "src/state-core.mjs",
    "src/state-core.cjs",
    "src/pricing.js",
    "src/headless-service.js",
    "src/agent-api.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    ".",
    "packages/*"
  ],
  "scripts": {
    "dev": "node cli.mjs",
    "mcp": "node packages/mcp/mcp-server.mjs",
    "build": "node build.mjs",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:coverage": "node --experimental-test-coverage --test",
    "check:dist": "node check-dist.mjs",
    "pack:check": "npm pack --dry-run --json",
    "prepublishOnly": "node --test && node build.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^18.19.130",
    "eslint": "^8.57.1",
    "globals": "^16.5.0",
    "lucide-static": "^1.77.0",
    "typescript": "^5.9.3"
  }
}
